<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEnableService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/enable_service"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 核心开关 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_core" />

        <LinearLayout
            style="@style/CardRow"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/switch_global" />

                <TextView
                    style="@style/RowDesc"
                    android:text="@string/switch_global_desc" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGlobal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            style="@style/CardRow"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/switch_builtin" />

                <TextView
                    style="@style/RowDesc"
                    android:text="@string/switch_builtin_desc" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBuiltin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 工具 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_tools" />

        <LinearLayout
            android:id="@+id/btnRules"
            style="@style/CardRow"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/btn_rules" />

                <TextView
                    style="@style/RowDesc"
                    android:text="@string/btn_rules_desc" />
            </LinearLayout>

            <TextView style="@style/Chevron" android:text="›" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLog"
            style="@style/CardRow"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/btn_log" />

                <TextView
                    style="@style/RowDesc"
                    android:text="@string/btn_log_desc" />
            </LinearLayout>

            <TextView style="@style/Chevron" android:text="›" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBattery"
            style="@style/CardRow"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/btn_battery" />

                <TextView
                    style="@style/RowDesc"
                    android:text="@string/btn_battery_desc" />
            </LinearLayout>

            <TextView style="@style/Chevron" android:text="›" />
        </LinearLayout>

        <!-- 统计 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_stats" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/StatBox"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statBlocked"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_blocked" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatBox"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statRules"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_rules" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatBox"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statDevice"
                    style="@style/StatValueSmall"
                    android:text="-" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stat_device" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
